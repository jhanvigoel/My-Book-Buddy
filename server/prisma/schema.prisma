generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id                   Int              @id @default(autoincrement())
  name                 String           @db.VarChar(191)
  email                String           @unique @db.VarChar(191)
  phone                String           @unique @db.VarChar(15)
  password             String
  photoUrl             String?
  friendshipsInitiated Friends[]        @relation("Friends_friend1")
  friendshipsReceived  Friends[]        @relation("Friends_friend2")
  readingHistory       ReadingHistory[]
  refreshTokens         RefreshToken[]
  reviews Review[]

  @@index([name])
}

model Book {
  id               Int              @id @default(autoincrement())
  title            String
  author           String
  coverUrl         String?
  googleVolumeId   String?          @unique
  infoLink         String?
  readingHistories ReadingHistory[]
  reviews Review[]

  @@index([title])
  @@index([author])
}

model ReadingHistory {
  id          Int        @id @default(autoincrement())
  userId      Int
  bookId      Int
  status      ReadStatus
  currentPage Int        @default(0)
  startedAt   DateTime?
  finishedAt  DateTime?
  book        Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId, status])
}


model Friends {
  id        Int          @id @default(autoincrement())
  friend1Id Int
  friend2Id Int
  status    FriendStatus @default(PENDING)
  createdAt DateTime     @default(now())
  friend1   User         @relation("Friends_friend1", fields: [friend1Id], references: [id], onDelete: Cascade)
  friend2   User         @relation("Friends_friend2", fields: [friend2Id], references: [id], onDelete: Cascade)

  @@unique([friend1Id, friend2Id])
  @@index([friend2Id, status])
  @@index([friend1Id, status])
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Review {

  id         Int      @id @default(autoincrement())
  userId     Int
  bookId     Int
  createdAt  DateTime @default(now())
  content    String   @db.Text
  rating     Int      @default(0)

  user       User     @relation(fields: [userId],references :[id], onDelete: Cascade)
  book       Book     @relation(fields: [bookId],references: [id], onDelete: Cascade)

  @@index([bookId,createdAt])
  @@index([userId])
}


enum ReadStatus {
  WANT_TO_READ
  READING
  COMPLETED
}

enum FriendStatus {
  ACCEPTED
  PENDING
  DENIED
}
